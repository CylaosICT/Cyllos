{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe - Cyllos{% endblock %}

{% block guest_body %}
    <div class="login-page">
        <div class="login-card">
            <div class="login-card__brand">
                <div class="login-card__mark">{% include 'components/_cylaos_logo.html.twig' %}</div>
                <div>
                    <h1>Nouveau mot de passe</h1>
                    <p class="login-card__subtitle">Choisissez un nouveau mot de passe</p>
                </div>
            </div>

            {{ form_start(form) }}
                <div class="field-group">
                    {{ form_widget(form) }}
                </div>
                <button class="btn btn--block" type="submit">Réinitialiser le mot de passe</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
