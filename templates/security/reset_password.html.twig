{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe - Cyllos{% endblock %}

{% block guest_body %}
    <div class="auth">
        {% include 'components/_auth_aside.html.twig' %}

        <main class="auth__main">
            <div class="auth__panel">
                <div class="auth__mobile-brand">
                    <span class="auth__mark">{% include 'components/_cylaos_logo.html.twig' %}</span> Cyllos
                </div>

                <div>
                    <h1 class="auth__title">Nouveau mot de passe</h1>
                    <p class="auth__subtitle">Choisissez un nouveau mot de passe.</p>
                </div>

                <div class="auth__form">
                    {{ form_start(form) }}
                        <div class="field-group">
                            {{ form_widget(form) }}
                        </div>
                        <button class="btn btn--block" type="submit">Réinitialiser le mot de passe</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </main>
    </div>
{% endblock %}
