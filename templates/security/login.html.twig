{% extends 'base.html.twig' %}

{% block title %}Connexion - Cyllos{% endblock %}

{% block guest_body %}
    <div class="login-page">
        <div class="login-card">
            <div class="login-card__brand">
                <div class="login-card__mark">{% include 'components/_cylaos_logo.html.twig' %}</div>
                <div>
                    <h1>Cyllos</h1>
                    <p class="login-card__subtitle">Connectez-vous à votre espace</p>
                </div>
            </div>

            {% if error %}
                <div class="flash flash--error">Identifiants invalides.</div>
            {% endif %}

            {% for label, messages in app.flashes(['success', 'error']) %}
                {% for message in messages %}
                    <div class="flash flash--{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <form method="post">
                <div class="form-row">
                    <label for="username">Adresse e-mail</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
                </div>
                <div class="form-row">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="_password" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="btn btn--block" type="submit">Se connecter</button>
            </form>

            <p class="text-sm text-muted" style="margin-top:1rem; text-align:center;">
                <a href="{{ path('app_forgot_password') }}">Mot de passe oublié ?</a>
            </p>
        </div>
    </div>
{% endblock %}
