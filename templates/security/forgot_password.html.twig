{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}Mot de passe oublié - Cyllos{% endblock %}

{% block guest_body %}
    <div class="auth">
        {% include 'components/_auth_aside.html.twig' %}

        <main class="auth__main">
            <div class="auth__panel">
                <div class="auth__mobile-brand">
                    <span class="auth__mark">{% include 'components/_cylaos_logo.html.twig' %}</span> Cyllos
                </div>

                <div>
                    <h1 class="auth__title">Mot de passe oublié</h1>
                    <p class="auth__subtitle">Réservé aux comptes clients. Nous vous enverrons un lien de réinitialisation.</p>
                </div>

                <div>
                    {% for label, messages in app.flashes(['success', 'error']) %}
                        {% for message in messages %}
                            <div class="flash flash--{{ label }}">{{ icons.render(label == 'success' ? 'check' : 'x') }} {{ message }}</div>
                        {% endfor %}
                    {% endfor %}
                </div>

                <div class="auth__form">
                    {{ form_start(form) }}
                        <div class="field-group">
                            {{ form_widget(form) }}
                        </div>
                        <button class="btn btn--block" type="submit">Envoyer le lien de réinitialisation</button>
                    {{ form_end(form) }}
                </div>

                <p class="auth__alt"><a href="{{ path('app_login') }}">← Retour à la connexion</a></p>
            </div>
        </main>
    </div>
{% endblock %}
