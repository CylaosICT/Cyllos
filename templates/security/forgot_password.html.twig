{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - Cyllos{% endblock %}

{% block guest_body %}
    <div class="login-page">
        <div class="login-card">
            <div class="login-card__brand">
                <div class="login-card__mark">{% include 'components/_cylaos_logo.html.twig' %}</div>
                <div>
                    <h1>Mot de passe oublié</h1>
                    <p class="login-card__subtitle">Réservé aux comptes clients</p>
                </div>
            </div>

            {% for label, messages in app.flashes(['success', 'error']) %}
                {% for message in messages %}
                    <div class="flash flash--{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {{ form_start(form) }}
                <div class="field-group">
                    {{ form_widget(form) }}
                </div>
                <button class="btn btn--block" type="submit">Envoyer le lien de réinitialisation</button>
            {{ form_end(form) }}

            <p class="text-sm text-muted" style="margin-top:1rem; text-align:center;">
                <a href="{{ path('app_login') }}">← Retour à la connexion</a>
            </p>
        </div>
    </div>
{% endblock %}
