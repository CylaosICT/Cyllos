{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}Mises à jour - Cyllos{% endblock %}
{% block content_width %}content--full{% endblock %}

{% block page_title %}Mises à jour{% endblock %}
{% block page_actions %}
    <a class="btn btn--secondary" href="{{ path('dev_version_show', {refresh: 1}) }}">{{ icons.render('sync') }} Vérifier maintenant</a>
    {% if is_granted('ROLE_DEVELOPER') and status.state in ['behind', 'diverged'] %}
        <form method="post" action="{{ path('dev_version_deploy') }}" data-confirm-title="Déployer la mise à jour" data-confirm-message="Une sauvegarde de la base et du code est faite d'abord, puis git pull, composer install, les migrations et le vidage du cache sont exécutés ici. En cas d'échec, la version précédente est restaurée. Continuer ?" data-confirm-confirm-label="Déployer">
            <input type="hidden" name="_token" value="{{ csrf_token('deploy_app') }}">
            <button class="btn btn--danger" type="submit">{{ icons.render('arrow-right') }} Déployer la mise à jour</button>
        </form>
    {% endif %}
{% endblock %}

{% block body %}
    <div>
        <div>
            {% if runningRun is defined and runningRun %}
                <div class="flash flash--info" style="margin-bottom:1.25rem;">
                    {{ icons.render('sync') }} Une mise à jour de {{ runningRun.targetLabel }} est en cours.
                    <a href="{{ path('dev_update_show', {id: runningRun.id}) }}">Suivre dans le terminal</a>
                </div>
            {% endif %}
            <div class="card">
                <div class="card__header">
                    <div>
                        <h2>État par rapport à {{ status.upstreamRepo }}</h2>
                        <p>Branche suivie : <code>{{ status.upstreamBranch }}</code></p>
                    </div>
                    {% if status.state == 'up_to_date' %}
                        <span class="badge badge--success">{{ icons.render('check') }} À jour</span>
                    {% elseif status.state == 'behind' %}
                        <span class="badge badge--warning">En retard de {{ status.behindBy }} commit{{ status.behindBy > 1 ? 's' : '' }}</span>
                    {% elseif status.state == 'ahead' %}
                        <span class="badge badge--waiting">En avance de {{ status.aheadBy }} commit{{ status.aheadBy > 1 ? 's' : '' }}</span>
                    {% elseif status.state == 'diverged' %}
                        <span class="badge badge--warning">Divergent ({{ status.behindBy }} en retard / {{ status.aheadBy }} en avance)</span>
                    {% else %}
                        <span class="badge badge--todo">Indisponible</span>
                    {% endif %}
                </div>

                <div class="card__body">
                    <dl class="kv-list">
                        <div class="kv-row">
                            <dt>Commit déployé ici</dt>
                            <dd>{% if status.localCommit %}<code>{{ status.localShort }}</code>{% else %}<span class="text-muted">inconnu</span>{% endif %}</dd>
                        </div>
                        <div class="kv-row">
                            <dt>Dernier commit sur {{ status.upstreamBranch }}</dt>
                            <dd>
                                {% if status.remoteCommit %}
                                    <code>{{ status.remoteShort }}</code>
                                    {% if status.remoteCommitDate %} · {{ status.remoteCommitDate|date('d/m/Y H:i') }}{% endif %}
                                {% else %}
                                    <span class="text-muted">inconnu</span>
                                {% endif %}
                            </dd>
                        </div>
                        <div class="kv-row">
                            <dt>Vérifié</dt>
                            <dd>{{ status.checkedAt|date('d/m/Y H:i:s') }}</dd>
                        </div>
                        {% if status.compareUrl %}
                            <div class="kv-row">
                                <dt>Détail</dt>
                                <dd><a href="{{ status.compareUrl }}" target="_blank" rel="noopener">Voir la comparaison sur GitHub {{ icons.render('external') }}</a></dd>
                            </div>
                        {% endif %}
                    </dl>

                    {% if status.errorMessage %}
                        <div class="flash flash--error" style="margin-top:1rem;">
                            {{ icons.render('x') }} {{ status.errorMessage }}
                        </div>
                    {% endif %}
                </div>
            </div>

            {% if paySite is defined and paySite is not null %}
                <div class="card" style="margin-top:1.5rem;">
                    <div class="card__header">
                        <div>
                            <h2>Site de paiement (Cyllos-Pay)</h2>
                            <p>Branche suivie : <code>{{ paySite.branch }}</code></p>
                        </div>
                        {% if paySite.running %}
                            <span class="badge badge--waiting">{{ icons.render('sync') }} Mise à jour en cours…</span>
                        {% elseif paySite.state == 'up_to_date' %}
                            <span class="badge badge--success">{{ icons.render('check') }} À jour</span>
                        {% elseif paySite.state == 'behind' %}
                            <span class="badge badge--warning">En retard de {{ paySite.behindBy }} commit{{ paySite.behindBy > 1 ? 's' : '' }}</span>
                        {% elseif paySite.state == 'ahead' %}
                            <span class="badge badge--waiting">En avance de {{ paySite.aheadBy }} commit{{ paySite.aheadBy > 1 ? 's' : '' }}</span>
                        {% else %}
                            <span class="badge badge--todo">Indisponible</span>
                        {% endif %}
                    </div>
                    <div class="card__body">
                        <dl class="kv-list">
                            <div class="kv-row">
                                <dt>Commit déployé</dt>
                                <dd>{% if paySite.localCommit %}<code>{{ paySite.localShort }}</code>{% else %}<span class="text-muted">inconnu</span>{% endif %}</dd>
                            </div>
                            <div class="kv-row">
                                <dt>Dernier commit sur {{ paySite.branch }}</dt>
                                <dd>
                                    {% if paySite.remoteCommit %}
                                        <code>{{ paySite.remoteShort }}</code>{% if paySite.remoteCommitDate %} · {{ paySite.remoteCommitDate|date('d/m/Y H:i') }}{% endif %}
                                    {% else %}
                                        <span class="text-muted">inconnu</span>
                                    {% endif %}
                                </dd>
                            </div>
                            <div class="kv-row">
                                <dt>Dernière mise à jour lancée d'ici</dt>
                                <dd>
                                    {% if paySite.lastRun == 'ok' %}Réussie{% elseif paySite.lastRun == 'failed' %}<strong>Échec</strong> — voir le journal ci-dessous{% elseif paySite.lastRun == 'running' %}En cours{% else %}Aucune{% endif %}
                                </dd>
                            </div>
                        </dl>

                        {% if paySite.errorMessage %}
                            <div class="flash flash--error" style="margin-top:1rem;">{{ icons.render('x') }} {{ paySite.errorMessage }}</div>
                        {% endif %}

                        {% if paySite.log %}
                            <pre class="deploy-result__pre" style="margin-top:1rem;">{{ paySite.log }}</pre>
                        {% endif %}

                        {% if is_granted('ROLE_DEVELOPER') and not paySite.running and paySite.state in ['behind', 'unknown'] and paySite.localCommit %}
                            <form method="post" action="{{ path('dev_version_deploy_pay') }}" style="margin-top:1rem;" data-confirm-title="Mettre à jour le site de paiement" data-confirm-message="Le site de paiement va récupérer le code, installer les dépendances et vider son cache. Pensez à mettre d'abord à jour Cyllos si la version apporte une migration. Continuer ?" data-confirm-confirm-label="Mettre à jour">
                                <input type="hidden" name="_token" value="{{ csrf_token('deploy_pay') }}">
                                <button class="btn btn--danger" type="submit">{{ icons.render('arrow-right') }} Mettre à jour Cyllos-Pay</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {% if recentRuns is defined and recentRuns is not empty %}
                <div class="card" style="margin-top:1.5rem;">
                    <div class="card__header">
                        <div><h2>Dernières mises à jour</h2></div>
                        <a class="btn btn--ghost btn--sm" href="{{ path('dev_update_list') }}">Tout l'historique</a>
                    </div>
                    <div class="card__body">
                        <dl class="kv-list">
                            {% for run in recentRuns %}
                                <div class="kv-row">
                                    <dt><a href="{{ path('dev_update_show', {id: run.id}) }}">{{ run.startedAt|date('d/m/Y H:i') }}</a> · {{ run.targetLabel }} <span class="text-muted">· {{ run.triggeredBy ?? '—' }}</span></dt>
                                    <dd><span class="badge {{ run.statusBadge }}">{{ run.statusLabel }}</span></dd>
                                </div>
                            {% endfor %}
                        </dl>
                    </div>
                </div>
            {% endif %}

            <p class="text-sm text-muted" style="margin-top:1rem;">
                Comparaison en lecture seule : rien n'est modifié ni téléchargé automatiquement.
                Le résultat est mis en cache 5 minutes ; utilisez "Vérifier maintenant" pour forcer un contrôle immédiat.
                {% if is_granted('ROLE_DEVELOPER') %}
                    Le bouton "Déployer la mise à jour" (réservé aux développeurs et au CEO) exécute réellement
                    <code>git pull</code>, <code>composer install</code>, les migrations et un vidage de cache sur ce
                    serveur, après une sauvegarde de sécurité (base et code) et avec retour automatique en cas d'échec — à utiliser en connaissance de cause (voir la documentation, section Déploiement).
                {% endif %}
            </p>
        </div>

    </div>
{% endblock %}
