{#
    Cyllos brand mark (blue gradient rounded square, open "C" with a core dot,
    echoing the Cyllos Pay logo), as scalable inline SVG so it stays crisp at
    any size (sidebar brand mark, login mark, avatars...).

    Usage: {% include 'components/_cylaos_logo.html.twig' %}
#}
{# Unique ids: a gradient defined inside a hidden (display:none) copy of the logo would break every other copy. #}
{% set uid = 'cy' ~ random(1000000) %}
<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Cyllos">
    <defs>
        <linearGradient id="{{ uid }}b" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#5aa8ff"/>
            <stop offset="100%" stop-color="#1558d6"/>
        </linearGradient>
        <radialGradient id="{{ uid }}g" cx="25%" cy="15%" r="75%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.38"/>
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
        </radialGradient>
    </defs>
    <rect width="100" height="100" rx="24" fill="url(#{{ uid }}b)"/>
    <rect width="100" height="100" rx="24" fill="url(#{{ uid }}g)"/>
    <path d="M69 32.5A26 26 0 1 0 69 67.5" fill="none" stroke="#ffffff" stroke-width="12.5" stroke-linecap="round"/>
    <circle cx="53" cy="50" r="7.5" fill="#ffffff"/>
</svg>
