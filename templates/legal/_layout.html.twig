{% extends 'base.html.twig' %}

{# Same content for signed-in users (inside the app shell) and visitors (standalone page). #}
{% block page_title %}{{ block('legal_title') }}{% endblock %}

{% block body %}
    <div class="card legal-doc">
        <div class="card__body">
            {{ block('legal_content') }}
        </div>
    </div>
{% endblock %}

{% block guest_body %}
    <div class="doc-page">
        <div class="doc-card legal-doc">
            <div class="doc-card__brand">
                <span class="auth__mark">{% include 'components/_cylaos_logo.html.twig' %}</span> Cyllos
            </div>
            <p class="text-sm"><a href="{{ path('app_login') }}">&larr; Retour à la connexion</a></p>
            <h1>{{ block('legal_title') }}</h1>
            {{ block('legal_content') }}
        </div>
    </div>
{% endblock %}

{% block legal_content %}{% endblock %}
