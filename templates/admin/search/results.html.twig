{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}Recherche — {{ query }} - Cyllos{% endblock %}
{% block content_width %}content--full{% endblock %}

{% block page_title %}Résultats pour « {{ query }} »{% endblock %}

{% block body %}
    {% if query is empty %}
        <div class="empty-state">
            <div class="empty-state__icon">{{ icons.render('inbox') }}</div>
            <h3>Tapez une recherche</h3>
            <p>Client, paiement (nom, e-mail, id, formulaire), redirection d'e-mail, compte utilisateur ou journal d'activité.</p>
        </div>
    {% elseif clients is empty and payments is empty and users is empty and emailAliases is empty and logs is empty %}
        <div class="empty-state">
            <div class="empty-state__icon">{{ icons.render('inbox') }}</div>
            <h3>Aucun résultat</h3>
            <p>Rien ne correspond à « {{ query }} ».</p>
        </div>
    {% else %}
        {% if clients is not empty %}
            <div class="card card--section">
                <div class="card__header"><h2>Clients</h2></div>
                <table>
                    <tbody>
                        {% for client in clients %}
                            <tr>
                                <td class="cell-primary">
                                    <a href="{{ path('admin_client_show', {id: client.id}) }}" class="name-with-avatar">
                                        {% include 'components/_client_avatar.html.twig' with {client: client, size: 'sm'} only %}
                                        {{ client.name }}
                                    </a>
                                </td>
                                <td class="cell-muted"><code>{{ client.slug }}</code></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {% if payments is not empty %}
            <div class="card card--section">
                <div class="card__header"><h2>Paiements</h2></div>
                <table>
                    <tbody>
                        {% for payment in payments %}
                            <tr>
                                <td class="cell-muted">{{ payment.helloAssoPaymentId }}</td>
                                <td class="cell-muted">{{ payment.helloAssoConfig.label }}</td>
                                <td class="cell-primary">{{ payment.payerFirstName }} {{ payment.payerLastName }}</td>
                                <td>{{ payment.email }}</td>
                                <td>{{ payment.amount|number_format(2, ',', ' ') }} €</td>
                                <td><span class="badge {{ payment.status.badgeClass }}">{{ payment.status.label }}</span></td>
                                <td><a href="{{ path('admin_payment_list', {client: payment.client.id}) }}">{{ payment.client.name }}</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {% if emailAliases is not empty %}
            <div class="card card--section">
                <div class="card__header"><h2>Redirections e-mail</h2></div>
                <table>
                    <tbody>
                        {% for alias in emailAliases %}
                            <tr>
                                <td class="cell-primary">{{ alias.sourceEmail }}</td>
                                <td>→ {{ alias.targetEmail }}</td>
                                <td><a href="{{ path('admin_email_alias_list', {client: alias.client.id}) }}">{{ alias.client.name }}</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {% if logs is not empty %}
            <div class="card card--section">
                <div class="card__header"><h2>Journal d'activité</h2></div>
                <table>
                    <tbody>
                        {% for log in logs %}
                            <tr>
                                <td class="cell-muted">{{ log.createdAt|date('d/m/Y H:i:s') }}</td>
                                <td>{{ log.actorEmail ?: 'Système' }}</td>
                                <td><code>{{ log.action }}</code></td>
                                <td class="cell-truncate" title="{{ log.summary }}">{{ log.summary }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {% if users is not empty %}
            <div class="card card--section">
                <div class="card__header"><h2>Comptes utilisateurs</h2></div>
                <table>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td class="cell-primary">{{ user.email }}</td>
                                <td class="cell-muted">{{ user.client ? user.client.name : 'Administrateur' }}</td>
                                <td>
                                    {% if user.client %}
                                        <a href="{{ path('admin_client_show', {id: user.client.id}) }}">Voir le client</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
