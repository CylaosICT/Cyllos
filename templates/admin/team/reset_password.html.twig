{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe — {{ targetUser.email }} - Cyllos{% endblock %}
{% block content_width %}content--narrow{% endblock %}

{% block breadcrumb %}<div class="topbar__crumb"><a href="{{ path('admin_team_list') }}">Équipe</a> / Mot de passe</div>{% endblock %}
{% block page_title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
    <div class="card">
        {{ form_start(form) }}
            <div class="field-group">
                <p class="text-sm text-muted">Nouveau mot de passe pour <strong>{{ targetUser.email }}</strong>.</p>
                {{ form_widget(form) }}
            </div>
            <div class="form-footer">
                <a class="btn btn--ghost" href="{{ path('admin_team_list') }}">Annuler</a>
                <button class="btn" type="submit">Réinitialiser</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
