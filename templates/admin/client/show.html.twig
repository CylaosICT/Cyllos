{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}{{ client.name }} - Cyllos{% endblock %}
{% block content_width %}content--full{% endblock %}

{% block breadcrumb %}<div class="topbar__crumb"><a href="{{ path('admin_client_list') }}">Clients</a> / {{ client.name }}</div>{% endblock %}
{% block page_title %}
    <span class="topbar__title--with-avatar">
        {% include 'components/_client_avatar.html.twig' with {client: client, size: 'md'} only %}
        <span class="client-header-title-block">
            <span class="client-header-name">{{ client.name }}</span>
            <span class="client-header-meta client-header-meta--inline">
                <span class="dot {{ client.active ? 'dot--active' : 'dot--inactive' }}"></span>
                {{ client.active ? 'Client actif' : 'Client inactif' }}
                <span class="text-muted">·</span>
                <a class="text-muted" href="#webhook-card">Voir l'URL de webhook</a>
            </span>
        </span>
    </span>
{% endblock %}
{% block page_actions %}
    <a class="btn btn--secondary" href="{{ path('admin_payment_list', {client: client.id}) }}">{{ icons.render('payments') }} Paiements</a>
    <form method="post" action="{{ path('admin_client_fetch', {id: client.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('client_fetch_' ~ client.id) }}">
        <button class="btn" type="submit">{{ icons.render('sync') }} Synchro HelloAsso</button>
    </form>
{% endblock %}

{% block body %}
    <div class="summary-grid">
        <div class="summary-card">
            <div class="summary-card__header">
                <div class="summary-card__title">
                    <span class="summary-card__icon">{{ icons.render('building') }}</span>
                    Informations
                </div>
                <a class="btn btn--ghost btn--sm" href="{{ path('admin_client_edit_info', {id: client.id}) }}">Modifier</a>
            </div>
            <div class="summary-card__body">
                <dl class="kv-list">
                    <div class="kv-row"><dt>Nom</dt><dd>{{ client.name }}</dd></div>
                    <div class="kv-row"><dt>Slug</dt><dd><code>{{ client.slug }}</code></dd></div>
                    <div class="kv-row"><dt>E-mail de contact</dt><dd>{{ client.contactEmail ?: '—' }}</dd></div>
                    <div class="kv-row"><dt>Statut</dt><dd>{{ client.active ? 'Actif' : 'Inactif' }}</dd></div>
                    <div class="kv-row"><dt>Créé le</dt><dd>{{ client.createdAt|date('d/m/Y') }}</dd></div>
                </dl>
            </div>
        </div>

        {% for haConfig in client.helloAssoConfigs %}
            <div class="summary-card">
                <div class="summary-card__header">
                    <div class="summary-card__title">
                        <span class="summary-card__icon">{{ icons.render('inbox') }}</span>
                        <span class="summary-card__title-stack">
                            <span class="summary-card__title-eyebrow">HelloAsso</span>
                            <span>
                                {{ haConfig.label }}
                                <span class="status-pill"><span class="dot {{ haConfig.active ? 'dot--active' : 'dot--inactive' }}"></span> {{ haConfig.active ? 'Actif' : 'Désactivé' }}</span>
                            </span>
                        </span>
                    </div>
                    <a class="btn btn--ghost btn--sm" href="{{ path('admin_client_edit_helloasso_config', {id: client.id, configId: haConfig.id}) }}">Modifier</a>
                </div>
                <div class="summary-card__body">
                    <dl class="kv-list">
                        <div class="kv-row"><dt>Organisation</dt><dd>{{ haConfig.organizationSlug }}</dd></div>
                        <div class="kv-row"><dt>Type de formulaire</dt><dd>{{ haConfig.formType }}</dd></div>
                        <div class="kv-row"><dt>Formulaire</dt><dd>{{ haConfig.formSlug }}</dd></div>
                        <div class="kv-row"><dt>Client ID</dt><dd><code>{{ haConfig.helloAssoClientId }}</code></dd></div>
                        <div class="kv-row"><dt>Montant max</dt><dd>{{ haConfig.maxAmount }} €</dd></div>
                    </dl>
                    <div class="summary-card__footer-action">
                        <form method="post" action="{{ path('admin_client_toggle_helloasso_config', {id: client.id, configId: haConfig.id}) }}" data-confirm-title="{{ haConfig.active ? 'Désactiver' : 'Réactiver' }} le formulaire" data-confirm-message="{{ haConfig.active ? 'Désactiver' : 'Réactiver' }} le formulaire \"{{ haConfig.label }}\" ?" data-confirm-confirm-label="{{ haConfig.active ? 'Désactiver' : 'Réactiver' }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_helloasso_config_' ~ haConfig.id) }}">
                            <button class="btn btn--ghost btn--sm" type="submit">{{ icons.render(haConfig.active ? 'x' : 'check') }} {{ haConfig.active ? 'Désactiver' : 'Réactiver' }}</button>
                        </form>
                        {% if haConfig.id == primaryHelloAssoConfigId %}
                            <span class="icon-btn" title="Le formulaire principal d'un client ne peut pas être supprimé, seulement désactivé" style="opacity:0.4; cursor:not-allowed;">{{ icons.render('trash') }}</span>
                        {% elseif haConfig.active %}
                            <span class="icon-btn" title="Désactivez le formulaire avant de pouvoir le supprimer" style="opacity:0.4; cursor:not-allowed;">{{ icons.render('trash') }}</span>
                        {% elseif haConfig.id in deletableHelloAssoConfigIds %}
                            <form method="post" action="{{ path('admin_client_delete_helloasso_config', {id: client.id, configId: haConfig.id}) }}" data-confirm-title="Supprimer le formulaire" data-confirm-message="Supprimer définitivement le formulaire \"{{ haConfig.label }}\" ? Cette action est irréversible.">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_helloasso_config_' ~ haConfig.id) }}">
                                <button class="btn btn--ghost btn--sm" type="submit">{{ icons.render('trash') }} Supprimer</button>
                            </form>
                        {% else %}
                            <span class="icon-btn" title="Ce formulaire a un historique de paiements, il ne peut pas être supprimé" style="opacity:0.4; cursor:not-allowed;">{{ icons.render('trash') }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}

        <div class="summary-card summary-card--add">
            <div class="summary-card__body summary-card__body--center">
                <p class="text-muted text-sm">Un formulaire distinct pour un autre public (ex. professionnels) ?</p>
                <a class="btn btn--secondary btn--sm" href="{{ path('admin_client_new_helloasso_config', {id: client.id}) }}">{{ icons.render('plus') }} Ajouter un formulaire HelloAsso</a>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-card__header">
                <div class="summary-card__title">
                    <span class="summary-card__icon">{{ icons.render('cyclos') }}</span>
                    Cyclos
                </div>
                <a class="btn btn--ghost btn--sm" href="{{ path('admin_client_edit_cyclos', {id: client.id}) }}">Modifier</a>
            </div>
            <div class="summary-card__body">
                <dl class="kv-list">
                    <div class="kv-row"><dt>URL</dt><dd>{{ client.cyclosConfig.baseUrl }}</dd></div>
                    <div class="kv-row"><dt>Utilisateur technique</dt><dd><code>{{ client.cyclosConfig.technicalUserId }}</code></dd></div>
                    <div class="kv-row"><dt>Groupe pro</dt><dd>{{ client.cyclosConfig.groupProInternal }}</dd></div>
                    <div class="kv-row"><dt>Groupe(s) particulier</dt><dd>{{ client.cyclosConfig.groupsPartInternal }}</dd></div>
                </dl>
            </div>
        </div>

        <div class="summary-card">
            <div class="summary-card__header">
                <div class="summary-card__title">
                    <span class="summary-card__icon">{{ icons.render('settings') }}</span>
                    Réglages
                </div>
                <a class="btn btn--ghost btn--sm" href="{{ path('admin_client_edit_settings', {id: client.id}) }}">Modifier</a>
            </div>
            <div class="summary-card__body">
                <dl class="kv-list">
                    <div class="kv-row"><dt>Paiements Cyclos</dt><dd>{{ client.setting.paymentCyclosEnabled ? 'Activés' : 'Désactivés (aperçu)' }}</dd></div>
                    <div class="kv-row"><dt>Mode automatique</dt><dd>{{ client.setting.paymentAutomaticEnabled ? 'Activé' : 'Désactivé' }}</dd></div>
                    <div class="kv-row"><dt>Mail principal</dt><dd>{{ client.setting.mailRecipient }}</dd></div>
                    <div class="kv-row"><dt>Notif. paiement réussi</dt><dd>{{ client.setting.notifySuccessOnPayment ? 'Activé' : 'Désactivé' }}</dd></div>
                    <div class="kv-row"><dt>Notif. paiement en échec</dt><dd>{{ client.setting.notifyFailureOnPayment ? 'Activé' : 'Désactivé' }}</dd></div>
                </dl>
            </div>
        </div>

    </div>

    {% set customization = client.customization %}
    {% set customEmailCount = customization ? customization.emailTemplates|length : 0 %}
    <div class="card card--section">
        <div class="card__header">
            <div>
                <h2>Personnalisation</h2>
                <p>Textes des e-mails automatiques et libellés propres à ce client. Vide = valeur par défaut de l’application.</p>
            </div>
            <a class="btn btn--secondary btn--sm" href="{{ path('admin_client_edit_customization', {id: client.id}) }}">{{ icons.render('settings') }} Modifier</a>
        </div>
        <div class="card__body">
            <dl class="kv-list" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem 1.5rem;">
                <div class="kv-row"><dt>Modèles d’e-mail modifiés</dt><dd>{{ customEmailCount > 0 ? customEmailCount ~ ' / 6' : 'aucun (défauts)' }}</dd></div>
                <div class="kv-row"><dt>Préfixe des sujets</dt><dd>{{ customization and customization.emailSubjectPrefix is not null ? '« ' ~ customization.emailSubjectPrefix ~ ' »' : '[Cyllos]' }}</dd></div>
                <div class="kv-row"><dt>Pied de page</dt><dd>{{ customization and customization.emailFooter ? 'défini' : '—' }}</dd></div>
                <div class="kv-row"><dt>Description Cyclos</dt><dd>{{ customization and customization.cyclosDescriptionPrefix ? '« ' ~ customization.cyclosDescriptionPrefix ~ ' »' : 'Paiement automatique, id technique ' }}</dd></div>
                <div class="kv-row"><dt>Libellé mode aperçu</dt><dd>{{ customization and customization.previewModeLabel ? customization.previewModeLabel : 'aperçu (non crédité)' }}</dd></div>
            </dl>
        </div>
    </div>

    <div class="card card--section" id="webhook-card">
        <div class="card__header">
            <div>
                <h2>URL de webhook HelloAsso</h2>
                <p>À renseigner comme URL de notification dans HelloAsso — la même quel que soit le nombre de formulaires du client. Le jeton en fin d'URL authentifie les notifications : ne le diffusez pas.</p>
            </div>
            <form method="post" action="{{ path('admin_client_regenerate_webhook_token', {id: client.id}) }}" data-confirm-title="Régénérer le jeton" data-confirm-message="Générer un nouveau jeton pour ce client ? L'URL actuelle cessera immédiatement de fonctionner tant que HelloAsso n'est pas mis à jour." data-confirm-confirm-label="Régénérer">
                <input type="hidden" name="_token" value="{{ csrf_token('regenerate_webhook_token_' ~ client.id) }}">
                <button class="btn btn--secondary btn--sm" type="submit">{{ icons.render('sync') }} Régénérer le jeton</button>
            </form>
        </div>
        <div class="card__body">
            {% set webhookUrl = absolute_url(path('webhook_helloasso', {clientSlug: client.slug, token: client.webhookToken})) %}
            <div class="copy-field" data-controller="copy">
                <code class="copy-field__value" data-copy-target="source" title="{{ webhookUrl }}">{{ webhookUrl }}</code>
                <button type="button" class="copy-field__btn" data-action="copy#copy" aria-label="Copier l'URL de webhook">
                    {{ icons.render('copy') }} <span data-copy-target="button">Copier</span>
                </button>
            </div>
        </div>
    </div>

    <div class="card card--section">
        <div class="card__header">
            <div>
                <h2>Comptes utilisateurs</h2>
                <p>Accès à l'espace client de {{ client.name }}.</p>
            </div>
            <a class="btn btn--secondary btn--sm" href="{{ path('admin_client_new_user', {id: client.id}) }}">{{ icons.render('plus') }} Nouveau compte</a>
        </div>
        {% if usersPagination.items is empty %}
            <div class="empty-state">
                <div class="empty-state__icon">{{ icons.render('mail') }}</div>
                <h3>Aucun compte pour ce client</h3>
                <p>Créez un accès pour que {{ client.name }} puisse consulter ses paiements.</p>
            </div>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>E-mail</th>
                        <th>Statut</th>
                        <th>Alimentation manuelle</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in usersPagination.items %}
                        <tr>
                            <td class="cell-primary">{{ user.email }}</td>
                            <td>
                                <span class="status-pill">
                                    <span class="dot {{ user.active ? 'dot--active' : 'dot--inactive' }}"></span>
                                    {{ user.active ? 'Actif' : 'Inactif' }}
                                </span>
                            </td>
                            <td>
                                <form method="post" action="{{ path('admin_client_toggle_user_manual_payment_credit', {id: client.id, userId: user.id}) }}" data-confirm-title="{{ user.canMarkPaymentManualCredit ? 'Retirer' : 'Accorder' }} la permission" data-confirm-message="{{ user.canMarkPaymentManualCredit ? 'Retirer à' : 'Accorder à' }} {{ user.email }} la permission de marquer un paiement comme alimenté manuellement ?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_client_user_manual_credit_' ~ user.id) }}">
                                    <button class="btn btn--secondary btn--sm" type="submit">
                                        <span class="dot {{ user.canMarkPaymentManualCredit ? 'dot--active' : 'dot--inactive' }}"></span>
                                        {{ user.canMarkPaymentManualCredit ? 'Autorisée' : 'Non autorisée' }}
                                    </button>
                                </form>
                            </td>
                            <td class="actions-cell">
                                <div class="actions">
                                    <a class="btn btn--secondary btn--sm" href="{{ path('admin_client_reset_user_password', {id: client.id, userId: user.id}) }}">{{ icons.render('key') }} Mot de passe</a>
                                    <form method="post" action="{{ path('admin_client_toggle_user_active', {id: client.id, userId: user.id}) }}" data-confirm-title="{{ user.active ? 'Désactiver' : 'Réactiver' }} le compte" data-confirm-message="{{ user.active ? 'Désactiver' : 'Réactiver' }} le compte {{ user.email }} ?" data-confirm-confirm-label="{{ user.active ? 'Désactiver' : 'Réactiver' }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_client_user_' ~ user.id) }}">
                                        <button class="btn btn--secondary btn--sm" type="submit">{{ icons.render(user.active ? 'x' : 'check') }} {{ user.active ? 'Désactiver' : 'Réactiver' }}</button>
                                    </form>
                                    {% if user.active %}
                                        <span class="icon-btn" title="Désactivez le compte avant de pouvoir le supprimer" style="opacity:0.4; cursor:not-allowed;">{{ icons.render('trash') }}</span>
                                    {% else %}
                                        <form method="post" action="{{ path('admin_client_delete_user', {id: client.id, userId: user.id}) }}" data-confirm-title="Supprimer le compte" data-confirm-message="Supprimer le compte {{ user.email }} ?">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                            <button class="btn btn--ghost btn--icon" type="submit" title="Supprimer">{{ icons.render('trash') }}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% include 'components/_pagination.html.twig' with {pagination: usersPagination, route: 'admin_client_show', params: {id: client.id}} only %}
        {% endif %}
    </div>

    <div class="card card--section">
        <div class="card__header">
            <div>
                <h2>Correspondances d'e-mail</h2>
                <p>Corrige automatiquement le crédit Cyclos quand l'e-mail HelloAsso du payeur ne correspond pas à son compte Cyclos.</p>
            </div>
            <a class="btn btn--secondary btn--sm" href="{{ path('admin_client_new_email_alias', {id: client.id}) }}">{{ icons.render('plus') }} Nouvelle règle</a>
        </div>
        {% if emailAliases is empty %}
            <div class="empty-state">
                <div class="empty-state__icon">{{ icons.render('mail') }}</div>
                <h3>Aucune règle</h3>
                <p>Ajoutez-en une si un paiement échoue parce que l'e-mail HelloAsso du payeur diffère de son compte Cyclos.</p>
            </div>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>E-mail HelloAsso</th>
                        <th>E-mail Cyclos utilisé</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for alias in emailAliases %}
                        <tr>
                            <td class="cell-primary">{{ alias.sourceEmail }}</td>
                            <td>{{ alias.targetEmail }}</td>
                            <td class="actions-cell">
                                <div class="actions">
                                    <form method="post" action="{{ path('admin_client_delete_email_alias', {id: client.id, aliasId: alias.id}) }}" data-confirm-title="Supprimer la règle" data-confirm-message="Supprimer la règle pour {{ alias.sourceEmail }} ?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_email_alias_' ~ alias.id) }}">
                                        <button class="btn btn--ghost btn--icon" type="submit" title="Supprimer">{{ icons.render('trash') }}</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    <div class="card card--section card--danger">
        <div class="card__header">
            <div>
                <h2>Zone de danger</h2>
                <p>{{ client.active ? 'Désactivez le client (dans "Informations") avant de pouvoir le supprimer.' : 'Cette action est définitive et supprime aussi ses paiements et comptes utilisateurs.' }}</p>
            </div>
            <form method="post" action="{{ path('admin_client_delete', {id: client.id}) }}" data-confirm-title="Supprimer le client" data-confirm-message="Supprimer définitivement {{ client.name }} et toutes ses données ?">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_client_' ~ client.id) }}">
                <button class="btn btn--danger" type="submit" {{ client.active ? 'disabled' : '' }}>{{ icons.render('trash') }} Supprimer le client</button>
            </form>
        </div>
    </div>
{% endblock %}
