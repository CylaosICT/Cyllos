{% extends 'base.html.twig' %}
{% import 'components/icons.html.twig' as icons %}

{% block title %}Clients - Cyllos{% endblock %}
{% block content_width %}content--full{% endblock %}

{% block page_title %}Clients{% endblock %}
{% block page_actions %}
    <a class="btn" href="{{ path('admin_client_new') }}">{{ icons.render('plus') }} Nouveau client</a>
{% endblock %}

{% block body %}
    {% if clients is empty %}
        <div class="table-wrapper">
            <div class="empty-state">
                <div class="empty-state__icon">{{ icons.render('building') }}</div>
                <h3>Aucun client configuré</h3>
                <p>Créez votre premier client pour connecter HelloAsso et Cyclos.</p>
            </div>
        </div>
    {% else %}
        {% set chunks = clients|batch(14) %}
        <div class="table-columns {{ chunks|length < 2 ? 'table-columns--single' : '' }}">
            {% for chunk in chunks %}
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Slug</th>
                                <th>Statut</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for client in chunk %}
                                <tr>
                                    <td class="cell-primary">
                                        <a href="{{ path('admin_client_show', {id: client.id}) }}" class="name-with-avatar">
                                            {% include 'components/_client_avatar.html.twig' with {client: client, size: 'sm'} only %}
                                            {{ client.name }}
                                        </a>
                                    </td>
                                    <td><code>{{ client.slug }}</code></td>
                                    <td>
                                        <span class="status-pill">
                                            <span class="dot {{ client.active ? 'dot--active' : 'dot--inactive' }}"></span>
                                            {{ client.active ? 'Actif' : 'Inactif' }}
                                        </span>
                                    </td>
                                    <td class="actions-cell">
                                        <div class="actions">
                                            <a class="btn btn--secondary btn--sm" href="{{ path('admin_payment_list', {client: client.id}) }}">Paiements</a>
                                            <a class="btn btn--secondary btn--sm" href="{{ path('admin_client_show', {id: client.id}) }}">Détails {{ icons.render('chevron-right') }}</a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endfor %}
        </div>
        {% include 'components/_pagination.html.twig' with {pagination: pagination, route: 'admin_client_list', params: {}} only %}
    {% endif %}
{% endblock %}
