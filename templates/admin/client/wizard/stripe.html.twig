{% extends 'base.html.twig' %}

{% block title %}Nouveau client — Stripe - Cyllos{% endblock %}
{% block content_width %}content--full{% endblock %}

{% block breadcrumb %}<div class="topbar__crumb"><a href="{{ path('admin_client_list') }}">Clients</a> / Nouveau</div>{% endblock %}
{% block page_title %}Configuration Stripe{% endblock %}

{% block body %}
    {% include 'admin/client/wizard/_stepper.html.twig' with {currentStep: 3, provider: provider} %}

    <div class="card">
        {{ form_start(form) }}
            <div class="field-group">
                <h2 style="font-size:1rem;margin-bottom:0.35rem;">Compte Stripe du client</h2>
                <p class="text-sm text-muted" style="margin-bottom:1.1rem;">Les paiements arrivent directement sur le compte Stripe du client. Les clés sont chiffrées en base et ne sont plus jamais affichées.</p>
                <div class="form-grid form-grid--wide">
                    {{ form_row(form.secretKey) }}
                    {{ form_row(form.webhookSecret) }}
                    {{ form_row(form.minAmount) }}
                    {{ form_row(form.maxAmount) }}
                </div>
            </div>
            <div class="field-group">
                <h2 style="font-size:1rem;margin-bottom:0.35rem;">Identité de la page de paiement</h2>
                <p class="text-sm text-muted" style="margin-bottom:1.1rem;">Couleurs de la page vue par les payeurs (le logo est celui de la fiche client). Facultatif : modifiable ensuite.</p>
                <div class="form-grid form-grid--wide">
                    {{ form_row(form.brandPrimaryColor) }}
                    {{ form_row(form.brandBackgroundColor) }}
                    {{ form_row(form.brandSurfaceColor) }}
                    {{ form_row(form.brandTextColor) }}
                </div>
            </div>
            <div class="form-footer">
                <a class="btn btn--ghost" href="{{ path('admin_client_new_provider') }}">← Retour</a>
                <button class="btn" type="submit">Continuer</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
