{% use 'form_div_layout.html.twig' %}

{%- block form_row -%}
    <div class="form-row {{ row_attr.class|default('') }}">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock form_row -%}

{%- block checkbox_row -%}
    <div class="form-row form-row--checkbox {{ row_attr.class|default('') }}">
        {{- form_widget(form) -}}
        <div>
            {{- form_label(form) -}}
            {{- form_help(form) -}}
        </div>
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <div class="form-errors">
            {%- for error in errors -%}
                {{ error.message }}{% if not loop.last %} · {% endif %}
            {%- endfor -%}
        </div>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        <div class="help">{{ help|trans(help_translation_parameters, translation_domain) }}</div>
    {%- endif -%}
{%- endblock form_help -%}
